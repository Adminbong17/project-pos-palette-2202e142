{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>pt|patient|patients)\\.sheikhpharma\\.shop"
        }
      ],
      "destination": "/patient",
      "permanent": false
    },
    {
      "source": "/auth",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>pt|patient|patients)\\.sheikhpharma\\.shop"
        }
      ],
      "destination": "/patient",
      "permanent": false
    }
  ]
}
